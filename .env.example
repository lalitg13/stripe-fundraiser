# Copy this file to .env.local and fill in your TEST keys.
# Never commit .env.local, and never use live (sk_live_ / pk_live_) keys for this project.

# From https://dashboard.stripe.com/test/apikeys (Test mode must be ON)
STRIPE_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# From the Stripe CLI: `stripe listen --forward-to localhost:3000/api/webhook`
# The CLI prints a whsec_... signing secret each time you start `stripe listen`.
# After you deploy, use the signing secret from the Dashboard webhook endpoint instead.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Public URL of this app (no trailing slash)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Local SQLite file. The folder is created at runtime. Do not use a committed path
# that already contains real customer data.
DATABASE_PATH=./data/fundraiser.db

# Simple shared password for the admin page (you will check this yourself).
# This is fine for a personal demo; do not treat it as real production auth.
ADMIN_PASSWORD=change-me

# Optional: if you send your own receipt emails (Resend, Nodemailer, etc.)
# RESEND_API_KEY=re_replace_me
# RECEIPT_FROM_EMAIL="Hill Top News <news@example.com>"
